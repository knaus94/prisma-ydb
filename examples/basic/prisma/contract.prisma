// use prisma-8

model Project {
  id    String @id @default(uuid())
  name  String
  tasks Task[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], index: false)

  @@index([projectId])
}
